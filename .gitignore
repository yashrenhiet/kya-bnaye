# Dart/Flutter — pub workspace resolves from the repo root, so every
# member (and the root) gets its own generated .dart_tool/. The single
# root pubspec.lock IS committed on purpose: this is an application
# (app/), and applications pin their lockfile for reproducible builds —
# see docs/adr/004-pure-dart-core.md for the workspace layout.
# (Now under legacy/; kept until legacy/ is deleted, see ADR 009.)
.dart_tool/
.packages

# Local coverage output (scripts/check.sh; legacy/tool/check.sh).
coverage/

# Swift / SwiftPM / Xcode
.build/
.swiftpm/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/
*.profraw
*.profdata
*.xcresult

# scripts/check.sh keeps the xcodebuild log here
build-logs/
