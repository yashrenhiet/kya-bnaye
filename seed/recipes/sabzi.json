        {"ingredientId": "tomato", "quantityText": "1 medium"},
        {"ingredientId": "ginger", "quantityText": "1 inch"},
        {"ingredientId": "green_chilli", "quantityText": "1"},
        {"ingredientId": "cumin_seeds", "quantityText": "1 tsp"},
        {"ingredientId": "turmeric", "quantityText": "1/2 tsp"},
        {"ingredientId": "red_chilli_powder", "quantityText": "1 tsp"},
        {"ingredientId": "coriander_powder", "quantityText": "1 tsp"},
        {"ingredientId": "garam_masala", "quantityText": "1/2 tsp"},
        {"ingredientId": "salt", "quantityText": "to taste"},
        {"ingredientId": "cooking_oil", "quantityText": "2 tbsp"},
        {"ingredientId": "coriander_leaves", "quantityText": "small handful", "isOptional": true}
      ],
      "steps": [
