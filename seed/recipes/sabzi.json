{
  "recipes": [
    {
      "id": "aloo_baingan",
      "name": "Aloo Baingan",
      "mealTypes": ["lunch", "dinner"],
      "minutes": 30,
      "base": "roti",
      "tags": {"region": "north", "dishType": "drySabzi", "flavours": ["spicy", "savoury"], "heaviness": "medium", "protein": "vegOnly"},
      "ingredients": [
        {"ingredientId": "potato", "quantityText": "2 medium"},
        {"ingredientId": "brinjal", "quantityText": "2 small"},
        {"ingredientId": "onion", "quantityText": "1 medium"},
        {"ingredientId": "tomato", "quantityText": "1 medium"},
        {"ingredientId": "green_chilli", "quantityText": "1"},
        {"ingredientId": "cumin_seeds", "quantityText": "1 tsp"},
        {"ingredientId": "turmeric", "quantityText": "1/2 tsp"},
        {"ingredientId": "red_chilli_powder", "quantityText": "1 tsp"},
        {"ingredientId": "coriander_powder", "quantityText": "1 tsp"},
        {"ingredientId": "salt", "quantityText": "to taste"},
        {"ingredientId": "cooking_oil", "quantityText": "2 tbsp"},
        {"ingredientId": "coriander_leaves", "quantityText": "small handful", "isOptional": true}
      ],
      "steps": [
        "Cut potato and brinjal into similar-sized cubes; keep the brinjal in water so it does not darken.",
        "Heat oil, add jeera, then chopped onion and green chilli and fry till soft.",
        "Add the potatoes with turmeric and salt, cover and cook for 5 minutes.",
        "Add brinjal, tomato and the powdered spices and mix well.",
        "Cover and cook on low, stirring now and then, until both vegetables are tender.",
        "Garnish with coriander and serve with roti."
      ],
      "imageAsset": null
    },
