      "mealTypes": ["lunch", "dinner"],
      "minutes": 30,
      "base": "roti",
      "tags": {"region": "north", "dishType": "curry", "flavours": ["spicy", "savoury"], "heaviness": "medium", "protein": "vegOnly"},
