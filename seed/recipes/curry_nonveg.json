        {"ingredientId": "curd", "quantityText": "1/2 cup"},
        {"ingredientId": "ginger_garlic_paste", "quantityText": "1 tbsp"},
        {"ingredientId": "kashmiri_chilli_powder", "quantityText": "2 tsp"},
        {"ingredientId": "tomato", "quantityText": "4 large"},
        {"ingredientId": "butter", "quantityText": "3 tbsp"},
        {"ingredientId": "fresh_cream", "quantityText": "1/4 cup"},
        {"ingredientId": "kasuri_methi", "quantityText": "1 tsp"},
        {"ingredientId": "cashews", "quantityText": "10", "isOptional": true},
        {"ingredientId": "garam_masala", "quantityText": "1 tsp"},
        {"ingredientId": "sugar", "quantityText": "1 tsp"},
        {"ingredientId": "cooking_oil", "quantityText": "1 tbsp"},
        {"ingredientId": "salt", "quantityText": "to taste"}
      ],
      "steps": [
        "Marinate the chicken in curd, half the ginger-garlic paste, half the Kashmiri chilli and salt for at least 30 minutes.",
        "Sear the chicken in a hot pan with oil until charred at the edges; set aside.",
        "In butter, cook the remaining paste, then the chopped tomatoes (and cashews if using) until very soft; blend smooth.",
        "Return the sauce to the pan with the rest of the chilli powder, garam masala, sugar and salt; simmer 5 minutes.",
        "Add the chicken, simmer until cooked through, then stir in cream and crushed kasuri methi."
      ],
