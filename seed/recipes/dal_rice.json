    {
      "id": "bengali_masoor_dal",
      "name": "Bengali Masoor Dal",
      "mealTypes": ["lunch", "dinner"],
      "minutes": 25,
      "base": "rice",
      "tags": {"region": "east", "dishType": "dal", "flavours": ["savoury"], "heaviness": "light", "protein": "dalLegume"},
      "ingredients": [
        {"ingredientId": "masoor_dal", "quantityText": "1 cup"},
        {"ingredientId": "onion", "quantityText": "1 small"},
        {"ingredientId": "tomato", "quantityText": "1 small"},
        {"ingredientId": "green_chilli", "quantityText": "2 slit"},
        {"ingredientId": "panch_phoron", "quantityText": "1 tsp"},
        {"ingredientId": "turmeric", "quantityText": "1/2 tsp"},
        {"ingredientId": "salt", "quantityText": "to taste"},
        {"ingredientId": "mustard_oil", "quantityText": "1 tbsp"},
        {"ingredientId": "coriander_leaves", "quantityText": "small handful", "isOptional": true}
      ],
      "steps": [
        "Rinse the masoor dal and pressure cook with turmeric and salt for 2 whistles until soft.",
        "Whisk the cooked dal lightly so it turns smooth but still pourable.",
        "Heat mustard oil until it smokes lightly, then let it cool a few seconds and add panch phoron.",
        "When the seeds crackle, add sliced onion and slit green chillies and fry till golden.",
        "Add chopped tomato and cook until it softens.",
        "Pour the tempering into the dal, simmer for 3-4 minutes and garnish with coriander."
      ],
      "imageAsset": null
    },
    {
      "id": "bisi_bele_bath",
      "name": "Bisi Bele Bath",
      "mealTypes": ["lunch", "dinner"],
      "minutes": 50,
      "base": "rice",
      "tags": {"region": "south", "dishType": "onePot", "flavours": ["spicy", "tangy", "savoury"], "heaviness": "heavy", "protein": "dalLegume"},
      "ingredients": [
        {"ingredientId": "rice", "quantityText": "1 cup"},
        {"ingredientId": "toor_dal", "quantityText": "1/2 cup"},
        {"ingredientId": "carrot", "quantityText": "1 medium"},
        {"ingredientId": "french_beans", "quantityText": "8-10"},
        {"ingredientId": "green_peas", "quantityText": "1/2 cup"},
        {"ingredientId": "tamarind", "quantityText": "lemon-sized ball"},
        {"ingredientId": "sambar_powder", "quantityText": "2 tbsp"},
        {"ingredientId": "turmeric", "quantityText": "1/2 tsp"},
        {"ingredientId": "salt", "quantityText": "to taste"},
        {"ingredientId": "mustard_seeds", "quantityText": "1 tsp"},
        {"ingredientId": "asafoetida", "quantityText": "a pinch"},
        {"ingredientId": "ghee", "quantityText": "2 tbsp"},
        {"ingredientId": "curry_leaves", "quantityText": "8-10 leaves", "isOptional": true},
        {"ingredientId": "cashews", "quantityText": "10-12", "isOptional": true}
      ],
      "steps": [
        "Wash rice and toor dal together and pressure cook with turmeric and plenty of water until very soft.",
        "Soak tamarind in warm water for 10 minutes and squeeze out the pulp.",
        "Boil chopped carrot, beans and peas in the tamarind water with salt until tender.",
        "Stir in sambar powder and let it bubble for 3 minutes.",
        "Add the mashed rice-dal mix and simmer, stirring, until it becomes a thick porridge-like mass.",
        "Heat ghee, fry cashews, then add mustard seeds, hing and curry leaves.",
        "Pour the tempering on top and serve hot; it thickens as it cools, so loosen with hot water if needed."
      ],
