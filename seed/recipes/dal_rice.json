      "ingredients": [
        {"ingredientId": "whole_urad", "quantityText": "3/4 cup, soaked overnight"},
        {"ingredientId": "rajma", "quantityText": "2 tbsp, soaked overnight"},
        {"ingredientId": "butter", "quantityText": "2 tbsp"},
        {"ingredientId": "fresh_cream", "quantityText": "3 tbsp"},
