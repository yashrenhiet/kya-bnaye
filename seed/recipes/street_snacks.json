      "name": "Aloo Tikki Chaat",
      "mealTypes": ["snack"],
      "minutes": 40,
      "base": "none",
      "tags": {"region": "street", "dishType": "snack", "flavours": ["spicy", "tangy", "sweet"], "heaviness": "medium", "protein": "vegOnly"},
      "ingredients": [
        {"ingredientId": "potato", "quantityText": "4 medium"},
        {"ingredientId": "cornflour", "quantityText": "2 tbsp"},
        {"ingredientId": "curd", "quantityText": "1 cup"},
        {"ingredientId": "tamarind", "quantityText": "lemon-sized ball"},
        {"ingredientId": "jaggery", "quantityText": "2 tbsp"},
        {"ingredientId": "chaat_masala", "quantityText": "1 tsp"},
        {"ingredientId": "green_chilli", "quantityText": "2"},
        {"ingredientId": "onion", "quantityText": "1 small"},
        {"ingredientId": "red_chilli_powder", "quantityText": "1/2 tsp"},
        {"ingredientId": "cooking_oil", "quantityText": "for shallow frying"},
        {"ingredientId": "salt", "quantityText": "to taste"},
        {"ingredientId": "sev", "quantityText": "2 tbsp", "isOptional": true},
        {"ingredientId": "pomegranate", "quantityText": "2 tbsp arils", "isOptional": true},
        {"ingredientId": "coriander_leaves", "quantityText": "handful", "isOptional": true}
      ],
      "steps": [
        "Boil and mash the potatoes, then knead in cornflour, chopped green chilli and salt.",
        "Shape into flat patties and shallow fry on a tawa until crisp and brown on both sides.",
