      "name": "Chole Bhature",
      "mealTypes": ["lunch"],
      "minutes": 90,
      "base": "roti",
      "tags": {"region": "punjabi", "dishType": "bread", "flavours": ["spicy", "tangy", "savoury"], "heaviness": "heavy", "protein": "dalLegume"},
      "ingredients": [
        {"ingredientId": "kabuli_chana", "quantityText": "1 1/2 cups, soaked overnight"},
        {"ingredientId": "maida", "quantityText": "2 cups"},
        {"ingredientId": "curd", "quantityText": "1/4 cup"},
        {"ingredientId": "baking_soda", "quantityText": "1/4 tsp"},
        {"ingredientId": "onion", "quantityText": "2 medium"},
        {"ingredientId": "tomato", "quantityText": "2 medium"},
        {"ingredientId": "ginger_garlic_paste", "quantityText": "1 tbsp"},
        {"ingredientId": "chole_masala", "quantityText": "2 tbsp"},
        {"ingredientId": "red_chilli_powder", "quantityText": "1 tsp"},
        {"ingredientId": "sugar", "quantityText": "1 tsp"},
        {"ingredientId": "cooking_oil", "quantityText": "for deep frying"},
        {"ingredientId": "salt", "quantityText": "to taste"},
        {"ingredientId": "tea", "quantityText": "1 tsp, tied in muslin", "isOptional": true}
      ],
      "steps": [
        "Knead maida with curd, baking soda, sugar, salt and a spoon of oil into a soft dough; rest it covered for 2 hours.",
        "Pressure cook the soaked chana with salt (and the tea bundle for a dark colour) until very soft.",
        "Fry the onion until brown, add ginger-garlic paste, tomatoes, chilli powder and chole masala; cook until thick.",
        "Add the chana with some cooking liquid, mash a few, and simmer 15 minutes until the gravy clings.",
        "Roll the dough into thick ovals and deep fry in hot oil, pressing gently so they puff up.",
        "Serve the bhature hot with chole, sliced onion and pickle."
